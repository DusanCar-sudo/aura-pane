{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aura-pane",
  "version": "0.1.0",
  "identifier": "dev.aura.pane",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aura",
        "width": 360,
        "height": 800,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
